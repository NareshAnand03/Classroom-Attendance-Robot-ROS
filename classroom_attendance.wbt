#VRML_SIM R2025a utf8
# Autonomous Classroom Attendance Robot - Pioneer 3-DX, 9 desks

EXTERNPROTO "webots://projects/robots/adept/pioneer3/protos/Pioneer3dx.proto"

WorldInfo {
  basicTimeStep 32
  coordinateSystem "ENU"
}
Viewpoint {
  orientation 1 0 0 -1.12
  position 0 10.8 11.8
  follow "Classroom Attendance Robot"
}
TexturedBackground {
}
TexturedBackgroundLight {
}

# Classroom floor (12 m x 10 m); its top surface is at y = 0.
Solid {
  translation 0 -0.05 0
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.78 0.80 0.82
        roughness 1
      }
      geometry Box {
        size 12 0.1 10
      }
    }
  ]
  name "classroom_floor"
  boundingObject Box {
    size 12 0.1 10
  }
}

# Classroom walls. The serpentine route remains inside the marked aisle region.
Solid {
  translation -5.92 0.75 0
  children [ Shape { appearance PBRAppearance { baseColor 0.88 0.88 0.84 roughness 1 } geometry Box { size 0.16 1.5 9.8 } } ]
  boundingObject Box { size 0.16 1.5 9.8 }
}
Solid {
  translation 5.92 0.75 0
  children [ Shape { appearance PBRAppearance { baseColor 0.88 0.88 0.84 roughness 1 } geometry Box { size 0.16 1.5 9.8 } } ]
  boundingObject Box { size 0.16 1.5 9.8 }
}
Solid {
  translation 0 0.75 -4.92
  children [ Shape { appearance PBRAppearance { baseColor 0.88 0.88 0.84 roughness 1 } geometry Box { size 11.8 1.5 0.16 } } ]
  boundingObject Box { size 11.8 1.5 0.16 }
}
Solid {
  translation 0 0.75 4.92
  children [ Shape { appearance PBRAppearance { baseColor 0.88 0.88 0.84 roughness 1 } geometry Box { size 11.8 1.5 0.16 } } ]
  boundingObject Box { size 11.8 1.5 0.16 }
}

# Front blackboard on the positive-Z wall.
Solid {
  translation 0 1.05 4.78
  children [ Shape { appearance PBRAppearance { baseColor 0.035 0.13 0.16 roughness 0.9 } geometry Box { size 3.8 0.85 0.05 } } ]
}

# Desk and student models. Each desk is a fixed box-shaped collision region,
# with a visible tabletop and four legs. Students are coloured visual markers.

DEF DESK_01 Solid {
  translation -3 0.38 -2
  name "Desk 01"
  children [
    Transform { translation 0 0.36 0 children [ Shape { appearance PBRAppearance { baseColor 0.58 0.35 0.17 roughness 0.8 } geometry Box { size 1.1 0.08 0.75 } } ] }
    Transform { translation -0.48 0  -0.30 children [ Shape { appearance PBRAppearance { baseColor 0.30 0.20 0.12 roughness 0.9 } geometry Box { size 0.07 0.72 0.07 } } ] }
    Transform { translation  0.48 0  -0.30 children [ Shape { appearance PBRAppearance { baseColor 0.30 0.20 0.12 roughness 0.9 } geometry Box { size 0.07 0.72 0.07 } } ] }
    Transform { translation -0.48 0   0.30 children [ Shape { appearance PBRAppearance { baseColor 0.30 0.20 0.12 roughness 0.9 } geometry Box { size 0.07 0.72 0.07 } } ] }
    Transform { translation  0.48 0   0.30 children [ Shape { appearance PBRAppearance { baseColor 0.30 0.20 0.12 roughness 0.9 } geometry Box { size 0.07 0.72 0.07 } } ] }
  ]
  boundingObject Box { size 1.1 0.76 0.75 }
}
DEF STUDENT_01 Solid {
  translation -3 0.38 -1.22
  name "Student 01"
  children [
    Shape { appearance PBRAppearance { baseColor 0.18 0.40 0.80 roughness 0.85 } geometry Cylinder { radius 0.17 height 0.72 } }
    Transform { translation 0 0.50 0 children [ Shape { appearance PBRAppearance { baseColor 0.88 0.68 0.49 roughness 0.8 } geometry Sphere { radius 0.16 } } ] }
  ]
  boundingObject Cylinder { radius 0.17 height 0.72 }
}

