# Robot starts in the lower-left aisle facing +X. Supervisor is enabled only
# for simulation pose feedback; no GPS node is used.
Pioneer3dx {
  translation -4.2 0.0975 -3.0
  rotation 0 1 0 -1.5707963
  name "Classroom Attendance Robot"
  controller "classroom_attendance"
  supervisor TRUE
  extensionSlot [
    Solid {
      translation 0 0.34 0
      name "camera_pole"
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.20 0.22 0.24 roughness 0.7 }
          geometry Cylinder { radius 0.025 height 0.55 }
        }
      ]
      boundingObject Cylinder { radius 0.025 height 0.55 }
    }
    Camera {
      translation 0 0.62 0
      name "attendance camera"
      width 320
      height 240
      fieldOfView 1.0
    }
  ]
}
